def render_progress(done, total):
    """Affiche la progression du scan"""
    percent = (done / total) * 100 if total > 0 else 0
    sys.stdout.write(
        f"\rProgress: {done} / {total} ({percent:.2f}%)\033[K"
    )
    sys.stdout.flush()


def print_result(message):
    """Affiche un résultat en effaçant la barre de progression"""
    sys.stdout.write("\r\033[K")
    sys.stdout.write(message + "\n")
    sys.stdout.flush()

