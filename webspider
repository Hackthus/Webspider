# =============================
# FONCTION : Check DNS avec types multiples
# =============================
def check_dns(domain, subdomain, timeout, resolvers=None, record_types=None):
    """
    Vérifie si un sous-domaine existe via DNS
    
    Args:
        domain: domaine principal
        subdomain: sous-domaine à tester
        timeout: timeout en secondes
        resolvers: liste de serveurs DNS
        record_types: liste de types d'enregistrements à vérifier
    
    Returns:
        dict: {full_domain, record_type, addresses} ou None
    """
    if record_types is None:
        record_types = ['A', 'AAAA', 'CNAME']
    
    full_domain = f"{subdomain}.{domain}" if subdomain else domain
    
    try:
        resolver = dns.resolver.Resolver()
        resolver.timeout = timeout
        resolver.lifetime = timeout
        
        if resolvers:
            resolver.nameservers = resolvers
        
        results = []
        
        for record_type in record_types:
            try:
                answers = resolver.resolve(full_domain, record_type)
                addresses = [str(rdata) for rdata in answers]
                
                if addresses:
                    results.append({
                        'domain': full_domain,
                        'type': record_type,
                        'addresses': addresses
                    })
            except (dns.resolver.NXDOMAIN, dns.resolver.NoAnswer):
                continue
            except dns.resolver.Timeout:
                continue
        
        return results if results else None
        
    except Exception:
        return None


# =============================
# FONCTION : Détection Wildcard
# =============================
def detect_wildcard(domain, timeout, resolvers=None):
    """
    Détecte si le domaine utilise des wildcard DNS
    
    Returns:
        set: ensemble d'IPs wildcard ou None
    """
    wildcard_ips = set()
    
    for _ in range(3):
        # Génère un sous-domaine aléatoire improbable
        random_sub = ''.join(random.choices(string.ascii_lowercase + string.digits, k=32))
        result = check_dns(domain, random_sub, timeout, resolvers, ['A'])
        
        if result:
            for r in result:
                if r['type'] == 'A':
                    wildcard_ips.update(r['addresses'])
    
    return wildcard_ips if wildcard_ips else None

