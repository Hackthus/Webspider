# =============================
# FONCTION : tester UNE URL
# =============================
def check_url(base_url, path, timeout, user_agent, cookies, verify_ssl=False, session=None):
    """
    Teste une URL et retourne (url, status_code, size)
    Lève TargetUnreachable si la cible est injoignable
    """

    if stop_event.is_set():
        return None, None, None

    # Construction de l'URL complète
    full_url = f"{base_url.rstrip('/')}/{path.lstrip('/')}"

    # Préparation des headers
    headers = {"User-Agent": user_agent}
    if cookies:
        headers["Cookie"] = cookies

    try:
        # Utilisation d'une session persistante si fournie (PERF +++)
        if session:
            response = session.get(
                full_url,
                timeout=timeout,
                allow_redirects=False,
                headers=headers,
                verify=verify_ssl
            )
        else:
            response = requests.get(
                full_url,
                timeout=timeout,
                allow_redirects=False,
                headers=headers,
                verify=verify_ssl
            )

        size = len(response.content)
        return full_url, response.status_code, size

    except requests.exceptions.Timeout:
        #  ERREUR FATALE → arrêt immédiat du scan
        raise TargetUnreachable(f"timeout atteint ({timeout}s)")

    except requests.exceptions.ConnectionError:
        #  ERREUR FATALE → arrêt immédiat du scan
        raise TargetUnreachable("erreur de connexion")

    except requests.exceptions.RequestException:
        # Erreur non critique → on ignore l'URL
        return full_url, None, None

