# FONCTION : Brute force Dir / File
# =============================
def brute_force(
    base_url,
    paths,
    threads,
    timeout,
    user_agent,
    cookies,
    output_file,
    excluded_sizes,
    scan_mode,
    valid_status_codes
):
    results = []
    timestamp = datetime.now().strftime("%Y-%m-%d %H:%M:%S")

    valid_codes = set(int(c.strip()) for c in valid_status_codes.split(","))
    total = len(paths)
    completed = 0
    lock = Lock()

    # ==========================
    #  HEALTH CHECK RAPIDE
    # ==========================
    try:
        requests.get(
            base_url,
            timeout=min(10, timeout),
            headers={"User-Agent": user_agent},
            cookies=cookies,
            allow_redirects=False
        )
    except Exception:
        print(f"{RED}[-] ERREUR : cible injoignable → {base_url}{RESET}")
        return False

    # ==========================
    #  DNS WARM-UP
    # ==========================
    try:
        hostname = base_url.replace("http://", "").replace("https://", "").split("/")[0]
        socket.gethostbyname(hostname)
    except Exception:
        pass

    start_time = time.time()

    # ==========================
    #  SESSION HTTP PERSISTANTE
    # ==========================
    session = requests.Session()
    session.headers.update({"User-Agent": user_agent})
    session.cookies.update(cookies or {})

    # ==========================
    #  THREADPOOL OPTIMISÉ
    # ==========================
    with ThreadPoolExecutor(max_workers=threads) as executor:
        futures = set()
        path_iter = iter(paths)

        # Warm-up threads
        for _ in range(threads):
            executor.submit(lambda: None)

        while True:
            # Soumission progressive
            while len(futures) < threads * 2:
                try:
                    path = next(path_iter)
                except StopIteration:
                    break

                futures.add(
                    executor.submit(
                        check_url,
                        base_url,
                        path,
                        timeout,
                        user_agent,
                        cookies,
                        False,
                        session
                    )
                )

            if not futures:
                break

            done, futures = wait(futures, return_when=FIRST_COMPLETED)

            for future in done:
                try:
                    url, status, size = future.result()

                except TargetUnreachable as e:
                    print(f"\n[-] ERREUR FATALE : {e} pour {base_url}")
                    executor.shutdown(wait=False, cancel_futures=True)
                    return False

                except Exception as e:
                    print(f"\n {RED}[-] Erreur inattendue : {e}{RESET}")
                    executor.shutdown(wait=False, cancel_futures=True)
                    return False

                with lock:
                    completed += 1
                    
                    # ==========================
                    #  FILTRAGE
                    # ==========================
                    found = False
                    if status in valid_codes:
                        if scan_mode == "file":
                            if size not in excluded_sizes:
                                found = True
                        else:
                            found = True

                    # ==========================
                    #  AFFICHAGE
                    # ==========================
                    if found:
                        # Efface la ligne de progression avant d'afficher le résultat
                        print("\r" + " " * 80 + "\r", end="")
                        
                        if scan_mode == "file":
                            msg = (
                                f"{GREEN}[+]{RESET} Trouvé "
                                f"[status:{GREEN}{status}{RESET}] "
                                f"[size:{GREEN}{format_size(size)}{RESET}] "
                                f"→ {url}"
                            )
                            results.append(f"{timestamp} | {status} | {size} | {url}")
                        else:
                            msg = (
                                f"{GREEN}[+]{RESET} Trouvé "
                                f"[status:{GREEN}{status}{RESET}] "
                                f"→ {url}"
                            )
                            results.append(f"{timestamp} | {status} | {url}")
                        
                        print(msg)
                    
                    # Réaffiche la progression
                    progress = (completed / total) * 100
                    print(f"\r[*] Progression : {completed}/{total} ({progress:.1f}%)", end="", flush=True)

    elapsed = time.time() - start_time

    # ==========================
    #  SAUVEGARDE
    # ==========================
    if output_file and results:
        try:
            with open(output_file, "w", encoding="utf-8") as f:
                f.write("# Scan Results\n")
                f.write(f"# Date: {timestamp}\n")
                f.write(f"# Target: {base_url}\n")
                f.write(f"# Found: {len(results)} items\n\n")
                f.write("\n".join(results))
            print(f"\n[*] Résultats sauvegardés dans : {output_file}")
