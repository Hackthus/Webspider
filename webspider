# FONCTION : Brute force Virtual Hosts
# =============================
def brute_force_vhost(
    base_url,
    vhosts,
    threads,
    timeout,
    user_agent,
    cookies,
    output_file,
    output_format,
    exclude_lengths,
    exclude_codes,
    follow_redirect,
    verbose
):
    """
    Brute force de virtual hosts
    """
    results = []
    timestamp = datetime.now().strftime("%Y-%m-%d %H:%M:%S")
    
    total = len(vhosts)
    completed = 0
    lock = Lock()
    
    # Parse excluded lengths
    excluded_lengths_set = set()
    if exclude_lengths:
        excluded_lengths_set = set(int(x.strip()) for x in exclude_lengths.split(","))
    
    # Parse excluded codes
    excluded_codes_set = set()
    if exclude_codes:
        excluded_codes_set = set(int(x.strip()) for x in exclude_codes.split(","))

    print(f"{BLUE}[*]{RESET} Énumération VHost pour : {CYAN}{base_url}{RESET}")
    print(f"{BLUE}[*]{RESET} Virtual hosts à tester : {CYAN}{total}{RESET}")
    
    # ==========================
    #  BASELINE DETECTION
    # ==========================
    session = requests.Session()
    session.headers.update({"User-Agent": user_agent})
    session.cookies.update(cookies or {})
    
    print(f"{BLUE}[*]{RESET} Détection de la réponse baseline...")
    baseline = get_baseline_response(base_url, timeout, user_agent, cookies, follow_redirect, session)
    
    if baseline:
        baseline_code, baseline_length = baseline
        print(f"{BLUE}[*]{RESET} Baseline : Code={baseline_code}, Length={baseline_length}")
        print(f"{BLUE}[*]{RESET} Les réponses identiques seront filtrées")
        # Ajouter automatiquement aux exclusions
        excluded_codes_set.add(baseline_code)
        excluded_lengths_set.add(baseline_length)
    else:
        print(f"{BLUE}[+]{RESET} Baseline non détectée, tous les résultats seront affichés")

    # ==========================
    #  HEALTH CHECK
    # ==========================
    try:
        requests.get(
            base_url,
            timeout=min(5, timeout),
            headers={"User-Agent": user_agent},
            cookies=cookies,
            allow_redirects=False,
            verify=False
        )
        print(f"{GREEN}[+]{RESET} Serveur cible accessible\n")
    except Exception as e:
        print(f"\n{RED}[-]{RESET} ERREUR : serveur injoignable → {base_url}")
        if verbose:
            print(f"{RED}[-]{RESET} Détail : {e}")
        return False

    start_time = time.time()

    # ==========================
    #  THREADPOOL VHOST
    # ==========================
    with ThreadPoolExecutor(max_workers=threads) as executor:
        futures = set()
        vhost_iter = iter(vhosts)

        while True:
            while len(futures) < threads * 2:
                try:
                    vhost = next(vhost_iter)
                except StopIteration:
                    break

                futures.add(
                    executor.submit(
                        check_vhost,
                        base_url,
                        vhost.strip(),
                        timeout,
                        user_agent,
                        cookies,
                        follow_redirect,
                        session
                    )
                )

            if not futures:
                break

            done, futures = wait(futures, return_when=FIRST_COMPLETED)

            for future in done:
                try:
                    vhost_result = future.result()

                except TargetUnreachable as e:
                    if verbose:
                        print(f"\n{RED}[-]{RESET} {e}")
                    continue
                except Exception as e:
                    if verbose:
                        print(f"\n{RED}[-]{RESET} Erreur : {e}")
                    continue

                with lock:
                    completed += 1
                    
                    if vhost_result:
                        vhost_name, status_code, content_length, title, headers = vhost_result
                        
                        # Filtrage par code
                        if status_code in excluded_codes_set:
                            if verbose:
                                print(f"\r{YELLOW}[-]{RESET} {vhost_name} [Code:{status_code}] (filtré)")
                            continue
                        
                        # Filtrage par longueur
                        if content_length in excluded_lengths_set:
                            if verbose:
                                print(f"\r{YELLOW}[-]{RESET} {vhost_name} [Length:{content_length}] (filtré)")
                            continue
                        
                        # Efface la ligne de progression
                        print("\r" + " " * 100 + "\r", end="")
                        
                        # Construction du message
                        msg = (
                            f"{GREEN}[+]{RESET} {vhost_name} "
                            f"[Code:{YELLOW}{status_code}{RESET}] "
                            f"[Size:{CYAN}{format_size(content_length)}{RESET}] "
                            f"[Title:{title}]"
                        )
                        
                        print(msg)
                        
                        results.append({
                            'vhost': vhost_name,
                            'status': status_code,
                            'length': content_length,
                            'title': title,
                            'headers': dict(headers)
                        })
                    
                    elif verbose:
                        pass
                    
                    # Réaffiche la progression
                    progress = (completed / total) * 100
                    print(f"\r{BLUE}[*]{RESET} Progression : {completed}/{total} ({progress:.1f}%)", end="", flush=True)

    elapsed = time.time() - start_time

    # ==========================
    #  SAUVEGARDE
    # ==========================
    if output_file and results:
        try:
            if output_format == "json":
                with open(output_file, "w", encoding="utf-8") as f:
                    json.dump({
                        "timestamp": timestamp,
                        "target": base_url,
                        "found": len(results),
                        "results": results
                    }, f, indent=2)
            
            elif output_format == "csv":
                with open(output_file, "w", encoding="utf-8", newline="") as f:
                    writer = csv.writer(f)
                    writer.writerow(["Timestamp", "VHost", "Status", "Length", "Title"])
                    for r in results:
                        writer.writerow([timestamp, r['vhost'], r['status'], r['length'], r['title']])
            
            else:  # txt
                with open(output_file, "w", encoding="utf-8") as f:
                    f.write(f"# Virtual Host Enumeration Results\n")
                    f.write(f"# Date: {timestamp}\n")
                    f.write(f"# Target: {base_url}\n")
                    f.write(f"# Found: {len(results)} vhosts\n\n")
                    for r in results:
                        f.write(f"{r['vhost']} [Status:{r['status']}] [Size:{r['length']}] [Title:{r['title']}]\n")
            
            print(f"\n{GREEN}[*]{RESET} Résultats sauvegardés dans : {output_file}")
        except Exception as e:
            print(f"\n{RED}[-]{RESET} Erreur écriture fichier : {e}")

    print(f"\n{GREEN}[*]{RESET} Scan terminé en {elapsed:.2f}s | VHosts trouvés : {len(results)}")

    return True

