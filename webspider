# =============================
# FONCTION : Check Virtual Host
# =============================
def check_vhost(
    base_url,
    vhost,
    timeout,
    user_agent,
    cookies,
    follow_redirect,
    session
):
    """
    Vérifie si un virtual host existe
    
    Args:
        base_url: URL du serveur (ex: http://192.168.1.10)
        vhost: nom du virtual host (ex: admin.example.com)
        timeout: timeout en secondes
        user_agent: User-Agent
        cookies: cookies HTTP
        follow_redirect: suivre les redirections
        session: session requests
    
    Returns:
        tuple: (vhost, status_code, content_length, title) ou None
    """
    try:
        headers = {
            "Host": vhost,
            "User-Agent": user_agent,
            "Accept": "*/*",
            "Connection": "close"
        }
        
        response = session.get(
            base_url,
            headers=headers,
            timeout=timeout,
            allow_redirects=follow_redirect,
            verify=False
        )
        
        content_length = len(response.content)
        
        # Extraction du titre de la page
        title = "N/A"
        if "text/html" in response.headers.get("Content-Type", ""):
            try:
                import re
                title_match = re.search(r'<title>(.*?)</title>', response.text, re.IGNORECASE)
                if title_match:
                    title = title_match.group(1).strip()[:100]  # Limite à 100 caractères
            except:
                pass
        
        return (vhost, response.status_code, content_length, title, response.headers)
        
    except requests.exceptions.Timeout:
        raise TargetUnreachable(f"Timeout pour {vhost}")
    except requests.exceptions.ConnectionError:
        raise TargetUnreachable(f"Connection error pour {vhost}")
    except Exception as e:
        return None

# =============================
# FONCTION : Détection baseline
# =============================
def get_baseline_response(
    base_url,
    timeout,
    user_agent,
    cookies,
    follow_redirect,
    session
):
    """
    Obtient la réponse baseline (vhost inexistant)
    pour détecter les différences
    
    Returns:
        tuple: (status_code, content_length)
    """

    # Génère un vhost aléatoire improbable
    random_vhost = ''.join(random.choices(string.ascii_lowercase + string.digits, k=32)) + ".example.com"
    
    try:
        result = check_vhost(
            base_url,
            random_vhost,
            timeout,
            user_agent,
            cookies,
            follow_redirect,
            session
        )
        
        if result:
            _, status_code, content_length, _, _ = result
            return (status_code, content_length)
    except:
        pass
    
    return None

