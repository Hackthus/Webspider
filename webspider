def generate_dir_paths(paths):
    """Retourne les chemins pour le mode directory"""
    return paths


def generate_file_paths(names, extensions):
    """Génère les combinaisons nom.extension"""
    generated = []
    for name in names:
        for ext in extensions:
            # Supprimer l'extension existante si présente
            base_name = name.rsplit('.', 1)[0] if '.' in name else name
            generated.append(f"{base_name}.{ext}")
    return generated

