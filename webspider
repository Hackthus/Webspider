# =============================
# FONCTION : charger la wordlist
# =============================
def load_wordlist(file_path):
    """Charge et retourne les lignes d'une wordlist"""
    try:
        if not os.path.exists(file_path):
            print(f"{RED}[-] Erreur : Le fichier '{file_path}' n'existe pas{RESET}")
            sys.exit(1)
        
        with open(file_path, "r", encoding="utf-8", errors="ignore") as f:
            lines = [
                line.strip()
                for line in f
                if line.strip() and not line.lstrip().startswith("#")
            ]
        
        if not lines:
            print(f"{RED}[-] Erreur : La wordlist est vide{RESET}")
            sys.exit(1)
        
        return lines
    
    except Exception as e:
        print(f"{RED}[-] Erreur lors de la lecture de la wordlist : {e}{RESET}")
        sys.exit(1)
