# FONCTION : Format de taille
# =============================
def format_size(size):
    """Convertit une taille en octets en format lisible"""
    if size is None:
        return "?"
    for unit in ["B", "KB", "MB", "GB"]:
        if size < 1024:
            return f"{size:.1f}{unit}"
        size /= 1024
    return f"{size:.1f}TB"

