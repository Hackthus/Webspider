def brute_force_dns(
    domain,
    subdomains,
    threads,
    timeout,
    output_file,
    output_format,
    resolvers=None,
    record_types=None,
    check_wildcard=False,
    verbose=False,
    show_cname=True,
    show_ips=True
):
    """
    Brute force de sous-domaines DNS
    """
    results = []
    timestamp = datetime.now().strftime("%Y-%m-%d %H:%M:%S")
    
    total = len(subdomains)
    completed = 0
    lock = Lock()
    
    if record_types is None:
        record_types = ['A', 'AAAA', 'CNAME']
    else:
        record_types = [rt.strip().upper() for rt in record_types.split(',')]

    print(f"[*] Énumération DNS pour : {GREEN}{domain}{RESET}")
    print(f"[*] Sous-domaines à tester : {GREEN}{total}{RESET}")
    print(f"[*] Types d'enregistrements : {GREEN}{', '.join(record_types)}{RESET}")
    
    # ==========================
    #  DÉTECTION WILDCARD
    # ==========================
    wildcard_ips = None
    if check_wildcard:
        print(f"\n{YELLOW}[*]{RESET} Détection des wildcards DNS...")
        wildcard_ips = detect_wildcard(domain, timeout, resolvers)
        
        if wildcard_ips:
            print(f"{YELLOW}[!]{RESET} Wildcard détecté : {', '.join(wildcard_ips)}")
            print(f"{YELLOW}[*]{RESET} Les résultats wildcard seront filtrés")
        else:
            print(f"{GREEN}[+]{RESET} Aucun wildcard détecté")

    # ==========================
    #  HEALTH CHECK DNS
    # ==========================
    try:
        resolver = dns.resolver.Resolver()
        resolver.timeout = min(5, timeout)
        if resolvers:
            resolver.nameservers = resolvers
            print(f"{GREEN}[*]{RESET} Serveurs DNS : {GREEN}{', '.join(resolvers)}{RESET}")
        resolver.resolve(domain, 'A')
        print(f"{GREEN}[+]{RESET} Domaine principal accessible\n")
    except Exception as e:
        print(f"\n{RED}[-]{RESET} ERREUR : domaine injoignable → {domain}")
        if verbose:
            print(f"{RED}[-]{RESET} Détail : {e}")
        return False

    start_time = time.time()

    # ==========================
    #  THREADPOOL DNS
    # ==========================
    with ThreadPoolExecutor(max_workers=threads) as executor:
        futures = set()
        subdomain_iter = iter(subdomains)

        while True:
            while len(futures) < threads * 2:
                try:
                    subdomain = next(subdomain_iter)
                except StopIteration:
                    break

                futures.add(
                    executor.submit(
                        check_dns,
                        domain,
                        subdomain.strip(),
                        timeout,
                        resolvers,
                        record_types
                    )
                )

            if not futures:
                break

            done, futures = wait(futures, return_when=FIRST_COMPLETED)

            for future in done:
                try:
                    dns_results = future.result()

                except Exception as e:
                    if verbose:
                        print(f"\n{RED}[-]{RESET} Erreur : {e}")

                with lock:
                    completed += 1
                    
                    if dns_results:
                        for dns_result in dns_results:
                            # Filtrage wildcard
                            if wildcard_ips and dns_result['type'] == 'A':
                                if any(ip in wildcard_ips for ip in dns_result['addresses']):
                                    continue
                            
                            # Filtrage CNAME si désactivé
