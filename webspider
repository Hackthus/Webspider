                                continue
                            
                            # Efface la ligne de progression
                            print("\r" + " " * 100 + "\r", end="")
                            
                            # Construction du message
                            addr_str = ", ".join(dns_result['addresses']) if show_ips else ""
                            
                            if show_ips:
                                msg = (
                                    f"{GREEN}[+]{RESET} {dns_result['domain']} "
                                    f"[{YELLOW}{dns_result['type']}{RESET}] "
                                    f"→ {GREEN}{addr_str}{RESET}"
                                )
                            else:
                                msg = f"{GREEN}[+]{RESET} {dns_result['domain']} [{YELLOW}{dns_result['type']}{RESET}]"
                            
                            print(msg)
                            
                            results.append(dns_result)
                    
                    elif verbose:
                        # Affiche les échecs en mode verbose
                        pass
                    
                    # Réaffiche la progression
                    progress = (completed / total) * 100
                    print(f"\r[*] Progression : {completed}/{total} ({progress:.1f}%)", end="", flush=True)

    elapsed = time.time() - start_time


#--------------------------------------------------------------------------------------------

 # ==========================
    #  SAUVEGARDE
    # ==========================
    if output_file and results:
        try:
            if output_format == "json":
                with open(output_file, "w", encoding="utf-8") as f:
                    json.dump({
                        "timestamp": timestamp,
                        "domain": domain,
                        "found": len(results),
                        "results": results
                    }, f, indent=2)
            
            else:  # txt
                with open(output_file, "w", encoding="utf-8") as f:
